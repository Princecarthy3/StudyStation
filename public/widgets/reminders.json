{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "Image",
              "url": "${$root.siteUrl}/icons/icon-192.png",
              "size": "Small",
              "style": "Person"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "Study Reminders",
              "weight": "Bolder",
              "size": "Medium",
              "color": "Accent"
            },
            {
              "type": "TextBlock",
              "text": "${$root.summaryText}",
              "spacing": "None",
              "isSubtle": true,
              "size": "Small"
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "separator": true,
      "spacing": "Medium",
      "items": [
        {
          "$data": "${$root.tasks}",
          "type": "Container",
          "spacing": "Small",
          "items": [
            {
              "type": "ColumnSet",
              "columns": [
                {
                  "type": "Column",
                  "width": "stretch",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${title}",
                      "weight": "Bolder",
                      "size": "Small",
                      "wrap": true
                    },
                    {
                      "type": "TextBlock",
                      "text": "${dueLabel}",
                      "isSubtle": true,
                      "size": "ExtraSmall",
                      "spacing": "None"
                    }
                  ]
                },
                {
                  "type": "Column",
                  "width": "auto",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${priorityLabel}",
                      "weight": "Bolder",
                      "size": "ExtraSmall",
                      "color": "${if(isHighPriority, 'Attention', 'Default')}"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.OpenUrl",
      "title": "View Tasks",
      "url": "${$root.siteUrl}/app?view=planner"
    },
    {
      "type": "Action.OpenUrl",
      "title": "New Reminder",
      "url": "${$root.siteUrl}/app?view=planner&action=new-task"
    }
  ]
}
