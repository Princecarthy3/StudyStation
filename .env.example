# PostgreSQL connection (use the Supabase pooler URL in production)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=legacy-anon-key-if-needed
# Server-only; required for lecture record/status operations and study-group
# membership, discussion, invitation, and session actions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenRouter — server-side only, never prefix with NEXT_PUBLIC_
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=google/gemini-2.5-flash
# Optional dedicated model for Stage 8 structured study generation.
OPENROUTER_STUDY_MODEL=google/gemini-2.5-flash
# Optional model tried if the study model is unavailable.
OPENROUTER_STUDY_FALLBACK_MODEL=
OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-large-v3
# OPENROUTER_VIDEO_MODEL=google/gemini-2.5-flash

# Fast, 100% Free Voice/Audio Transcription via Groq Cloud (Recommended)
# Sign up in 30 seconds at https://console.groq.com (no credit card required)
GROQ_API_KEY=your-groq-api-key
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Google Gemini API (Recommended for StudyStation AI Tutor & Note Generation - Free with 1M context: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_STUDY_MODEL=gemini-3.5-flash-lite

# Stage 10 Jitsi prototype; public meet.jit.si rooms are not access-controlled by StudyStation.
JITSI_MEET_DOMAIN=meet.jit.si

# Public deployment URL (Used for SEO canonicals, sitemap, OpenGraph and auth callbacks)
# In production, set to your live domain, e.g. https://your-domain.com or leave empty on Vercel to auto-detect
APP_URL=http://localhost:3000
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Web Push notifications. Generate a VAPID key pair with:
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:notifications@your-domain.example
# The public key is safe to expose to browsers.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key

# Google Search Console Ownership Verification
# Method 1 (Recommended): Meta tag verification token from Google Search Console
# (Defaults to "google4df8a6879662fa0d" which matches public/google4df8a6879662fa0d.html)
GOOGLE_SITE_VERIFICATION=google4df8a6879662fa0d


